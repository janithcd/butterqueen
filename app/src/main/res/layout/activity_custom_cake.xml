<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/customCakeRoot"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="@color/md_theme_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="22dp">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.ButterQueen.Button.Text" android:id="@+id/customBack" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="Back" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Request a Custom Cake"
            android:textSize="26sp" android:textStyle="bold"
            android:textColor="@color/md_theme_onBackground" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginBottom="18dp" android:text="Tell us your idea. We will review it and confirm the price before you order."
            android:textColor="@color/md_theme_onSurfaceVariant" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Cake flavour" android:textColor="@color/md_theme_onBackground" />
        <Spinner android:id="@+id/customFlavour" android:layout_width="match_parent" android:layout_height="52dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Preferred weight" android:textColor="@color/md_theme_onBackground" />
        <Spinner android:id="@+id/customWeight" android:layout_width="match_parent" android:layout_height="52dp" />
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ButterQueen.TextField"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Required date *">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/customDate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:inputType="none" android:focusable="false" android:clickable="true" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ButterQueen.TextField"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:hint="Message on cake (optional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/customMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLength="120" android:inputType="textCapSentences" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.ButterQueen.TextField"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:hint="Design notes / colours (optional)">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/customNotes" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:maxLength="1000" android:minLines="2" android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:text="Reference photo (optional)"
            android:textColor="@color/md_theme_onBackground" android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="Photos are preview-only on the free plan and are not attached to requests."
            android:textSize="12sp"
            android:textColor="@color/md_theme_onSurfaceVariant" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.ButterQueen.Button.Outlined" android:id="@+id/customTakePhoto" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Take Photo" />
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.ButterQueen.Button.Outlined" android:id="@+id/customGallery" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_marginStart="8dp" android:text="Gallery" />
        </LinearLayout>
        <ImageView android:id="@+id/customPhotoPreview" android:layout_width="match_parent"
            android:layout_height="210dp" android:layout_marginTop="12dp"
            android:visibility="gone" android:scaleType="centerCrop"
            android:contentDescription="Selected cake reference photo" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.ButterQueen.Button.Text" android:id="@+id/customRemovePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="Remove Photo"
            android:contentDescription="Remove selected reference photo"
            android:visibility="gone" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.ButterQueen.Button.Primary"
            android:id="@+id/customSubmit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Submit Custom Cake Request" />
    </LinearLayout>
</ScrollView>
