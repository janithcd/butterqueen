<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
            style="@style/Widget.ButterQueen.Card" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp" app:cardBackgroundColor="@color/md_theme_surfaceContainerLow" app:strokeColor="@color/md_theme_outlineVariant" app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/orderImageView"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_bq_stepper"
            android:contentDescription="Order"
            android:padding="20dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_bq_orders"
            android:tint="@color/md_theme_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/orderNameTextView"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chocolate Cake"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderQtyTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Qty: 1"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/orderPriceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rs. 2500.00"
                android:textColor="@color/md_theme_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/orderDateTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Date: 2026/03/30"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="12sp"
                android:alpha="0.75" />

            <TextView
                android:id="@+id/orderPaymentTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Payment: Cash on Delivery"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/orderStatusTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@android:color/transparent"
                android:text="Preparing"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
