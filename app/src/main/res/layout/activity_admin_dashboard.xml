<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adminDashboardRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/adminBack"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_bq_back"
        app:navigationIconTint="@color/md_theme_onSurface"
        app:title="Bakery Studio • Operations"
        app:titleTextColor="@color/md_theme_onSurface" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="ADMIN OPERATIONS"
            android:textSize="11sp"
            android:letterSpacing="0.15"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Inventory &amp; Orders"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Manage your catalog, review incoming orders and update fulfilment status"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/adminTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:singleSelection="true"
            app:selectionRequired="true">
            <com.google.android.material.button.MaterialButton
                android:id="@+id/adminProductsTab"
                style="@style/Widget.ButterQueen.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:checked="true"
                android:text="Products"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/adminOrdersTab"
                style="@style/Widget.ButterQueen.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Orders"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton
            style="@style/Widget.ButterQueen.Button.Primary"
                android:id="@+id/adminAddProductButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Product"
                android:textAllCaps="false" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/adminAddCategoryButton"
                style="@style/Widget.ButterQueen.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="+ Category"
                android:textAllCaps="false" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminStarterButton"
            style="@style/Widget.ButterQueen.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set up Cakes, Cupcakes and Brownies"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminManageCategoriesButton"
            style="@style/Widget.ButterQueen.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Manage Categories  •  Edit &amp; Hide"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminManageReviewsButton"
            style="@style/Widget.ButterQueen.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Manage Customer Reviews"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminCustomCakeRequestsButton"
            style="@style/Widget.ButterQueen.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Custom Cake Requests"
            android:textAllCaps="false" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/adminSalesReportsButton"
            style="@style/Widget.ButterQueen.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sales Reports &amp; Analytics"
            android:textAllCaps="false" />
        <TextView
            android:id="@+id/adminStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="12dp"
            android:text="Select a product or order to manage it"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="14sp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/adminRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
