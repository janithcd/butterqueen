<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="OUR STORY"
            android:textColor="@color/md_theme_primary"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ButterQueen"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="30sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Sweet moments made with love."
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="16sp" />
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.ButterQueen.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="20dp"
            app:cardBackgroundColor="@color/md_theme_primaryContainer">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Baked for every celebration"
                    android:textColor="@color/md_theme_onPrimaryContainer"
                    android:textSize="19sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Explore birthday and wedding cakes, cupcakes, and brownies. Cakes are priced by the kilogram; cupcakes and brownies are priced by the piece."
                    android:textColor="@color/md_theme_onPrimaryContainer"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Contact ButterQueen"
            android:textColor="@color/md_theme_onBackground"
            android:textSize="19sp"
            android:textStyle="bold" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.ButterQueen.Button.Primary"
            android:id="@+id/aboutCall"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            app:icon="@drawable/ic_bq_phone"
            app:iconTint="@color/md_theme_onPrimary"
            android:text="Call 0763227525" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/aboutEmail"
            style="@style/Widget.ButterQueen.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:text="Email info@butterqueen.com"
            app:icon="@drawable/ic_bq_mail" />
        <TextView
            android:id="@+id/aboutVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
