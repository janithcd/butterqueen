<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
            style="@style/Widget.ButterQueen.Card" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="144dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp" app:cardBackgroundColor="@color/md_theme_surfaceContainerLow" app:strokeColor="@color/md_theme_outlineVariant" app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="144dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="116dp"
            android:layout_height="144dp">

            <ImageView
                android:id="@+id/cakeImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Cake Image"
                android:scaleType="centerCrop"
                android:src="@drawable/cake_wallpaper" />

            <ImageButton
                android:id="@+id/wishlistButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_bq_icon_surface"
                android:contentDescription="Wishlist"
                android:padding="12dp"
                android:src="@drawable/ic_bq_favorite"
                android:tint="@color/md_theme_onSurface" />

        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/cakeNameTextView"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chocolate Dream Cake"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cakeDescriptionTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:text="Rich creamy chocolate with soft layers"
                android:textColor="@color/md_theme_onBackground"
                android:textSize="12sp"
                android:alpha="0.75" />

            <TextView
                android:id="@+id/cakeRatingTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="★ — / 5  •  0 reviews"
                android:textColor="@color/md_theme_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:contentDescription="Product average rating and review count" />

            <TextView
                android:id="@+id/cakePriceTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Rs. 2500.00"
                android:textColor="@color/md_theme_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
