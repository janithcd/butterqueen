<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="7dp"
        android:text="MADE WITH LOVE"
        android:letterSpacing="0.12"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/md_theme_primary" />

    <TextView
        android:id="@+id/ordersTitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your celebrations"
        android:textColor="@color/md_theme_onBackground"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/ordersSubtitleTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="All your bakery moments, in one place."
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/ordersProgress"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="20dp"
        android:indeterminateTint="@color/md_theme_primary"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/emptyOrdersGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="220dp"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_bq_orders"
            android:tint="@color/md_theme_primary"
            android:importantForAccessibility="no" />
        <TextView
            android:id="@+id/emptyOrdersTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="No orders yet. Your sweet journey starts here."
            android:textColor="@color/md_theme_onSurfaceVariant"
            android:textSize="15sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/emptyOrdersBrowseButton"
            style="@style/Widget.ButterQueen.Button.Outlined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Start shopping" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ordersRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

</LinearLayout>
