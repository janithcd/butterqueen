// DO NOT DEPLOY TO A REAL BUSINESS / LIVE-PAYMENT PROJECT.
// This full ruleset allows unverified DEMO PayHere card orders for a
// university viva. A modified client can forge sandbox_demo status.
// BACK UP your existing deployed Firestore rules before making any changes.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('role', '') == 'admin';
    }
    function ownsOrderAfterBatch(orderId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/orders/$(orderId))
        && getAfter(/databases/$(database)/documents/orders/$(orderId))
             .data.userId == request.auth.uid;
    }
    function ownsOrder(orderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/orders/$(orderId))
        && get(/databases/$(database)/documents/orders/$(orderId))
             .data.userId == request.auth.uid;
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();
      // A customer cannot give their own profile an admin role.
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'id', 'firstName', 'lastName', 'email', 'birthday',
          'phone', 'address', 'profileImageUrl', 'createdAtMillis'
        ])
        && request.resource.data.keys().hasAll([
          'id', 'firstName', 'lastName', 'email', 'birthday',
          'phone', 'address', 'profileImageUrl', 'createdAtMillis'
        ])
        && request.resource.data.id == uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'birthday', 'phone',
          'address', 'profileImageUrl'
        ])
      );
      allow delete: if isAdmin();

      match /cart/{cartId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
      // Private per-user notifications, created by Cloud Functions Admin SDK.
      match /notifications/{notificationId} {
        allow get, list: if isOwner(uid);
        allow create, delete: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read'])
          && request.resource.data.read == true;
      }

      // Android FCM registration, isolated to the signed-in account.
      match /pushTokens/{installationId} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly([
            'token', 'platform', 'updatedAtMillis'
          ])
          && request.resource.data.keys().hasAll([
            'token', 'platform', 'updatedAtMillis'
          ])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 20
          && request.resource.data.token.size() < 4096
          && request.resource.data.platform == 'android'
          && request.resource.data.updatedAtMillis is int;
        allow delete: if isOwner(uid);
      }
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // One public star review per verified buyer and product.
      match /reviews/{reviewUid} {
        allow get, list: if true;

        function boughtAndDelivered(orderId, itemId) {
          return signedIn()
            && orderId is string && orderId.size() > 0
            && itemId is string && itemId.size() > 0
            && exists(/databases/$(database)/documents/orders/$(orderId))
            && get(/databases/$(database)/documents/orders/$(orderId))
                .data.userId == request.auth.uid
            && get(/databases/$(database)/documents/orders/$(orderId))
                .data.orderStatus == 'delivered'
            && exists(/databases/$(database)/documents/orders/$(orderId)/items/$(itemId))
            && get(/databases/$(database)/documents/orders/$(orderId)/items/$(itemId))
                .data.productId == productId;
        }

        function validContent() {
          return request.resource.data.stars is int
            && request.resource.data.stars >= 1
            && request.resource.data.stars <= 5
            && request.resource.data.text is string
            && request.resource.data.text.size() >= 3
            && request.resource.data.text.size() <= 800;
        }

        allow create: if isOwner(reviewUid)
          && request.resource.data.keys().hasOnly([
            'userId', 'orderId', 'itemId', 'stars', 'text',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'userId', 'orderId', 'itemId', 'stars', 'text',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.userId == reviewUid
          && validContent()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time
          && boughtAndDelivered(request.resource.data.orderId,
                                request.resource.data.itemId);

        allow update: if isOwner(reviewUid)
          && resource.data.userId == reviewUid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['stars', 'text', 'updatedAt'])
          && validContent()
          && request.resource.data.updatedAt == request.time;

        allow delete: if false;
      }
    }

    match /orders/{orderId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'orderId', 'userId', 'customerName', 'customerPhone',
          'deliveryAddress', 'note', 'subtotalAmount', 'deliveryFee',
          'totalAmount', 'totalItems', 'paymentMethod', 'paymentReference',
          'paymentStatus', 'orderStatus', 'createdAtMillis'
        ])
        && request.resource.data.keys().hasAll([
          'orderId', 'userId', 'paymentMethod', 'paymentStatus', 'orderStatus'
        ])
        && request.resource.data.orderId == orderId
        && request.resource.data.userId == request.auth.uid
        && (
          (request.resource.data.paymentMethod == 'cash_on_delivery'
            && request.resource.data.paymentStatus == 'pending'
            && request.resource.data.orderStatus == 'placed')
          ||
          (request.resource.data.paymentMethod == 'payhere'
            && (
              (request.resource.data.paymentStatus == 'verification_pending'
                && request.resource.data.orderStatus == 'payment_pending')
              ||
              // UNIVERSITY VIVA SANDBOX ONLY. A customer can simulate an
              // SDK success; this is NOT proof that real money was collected.
              (request.resource.data.paymentStatus == 'sandbox_demo'
                && request.resource.data.orderStatus == 'placed')
            ))
        );
      // UNIVERSITY VIVA SANDBOX RULES. Admin cannot declare a real payment
      // 'paid'. The 'sandbox_demo' marker explicitly means NOT VERIFIED.
      allow update: if isAdmin() && (
        (
          request.resource.data.orderStatus in [
            'placed', 'preparing', 'out_for_delivery', 'delivered',
            'cancelled', 'payment_pending'
          ]
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['orderStatus'])
          && (resource.data.paymentMethod != 'payhere'
            || resource.data.paymentStatus in ['paid', 'sandbox_demo']
            || request.resource.data.orderStatus in ['payment_pending', 'cancelled'])
        )
        ||
        (
          // One-time migration for older demo orders stuck after an SDK
          // success but before trusted backend verification was configured.
          resource.data.paymentMethod == 'payhere'
          && resource.data.paymentStatus == 'verification_pending'
          && resource.data.orderStatus == 'payment_pending'
          && request.resource.data.paymentStatus == 'sandbox_demo'
          && request.resource.data.orderStatus == 'placed'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['paymentStatus', 'orderStatus'])
        )
      );
      allow delete: if false;

      match /items/{itemId} {
        allow get, list: if isAdmin() || ownsOrder(orderId);
        allow create: if ownsOrderAfterBatch(orderId)
          && request.resource.data.keys().hasOnly([
            'orderItemId', 'productId', 'productName', 'productImageUrl',
            'unitPrice', 'quantity', 'unitType', 'selectedSize',
            'selectedFlavor', 'cakeMessage', 'itemTotal'
          ])
          && request.resource.data.orderItemId == itemId;
        allow update, delete: if false;
      }
    }

    // This collection is not used by this Android repo. Define its schema
    // and allowed initial status before enabling customer writes.
    match /surpriseDeliveries/{deliveryId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
