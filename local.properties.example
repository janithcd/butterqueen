# Add these entries to the local.properties created by Android Studio.
# Do not commit local.properties. Use a separate restricted Maps SDK for Android key.
MAPS_API_KEY=
# Sandbox Merchant ID only. A PayHere Merchant Secret must stay on a trusted server.
PAYHERE_MERCHANT_ID=
# Firebase HTTPS Function URL (public endpoint, not a secret). Must start with https://.
PAYHERE_NOTIFY_URL=
